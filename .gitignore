# ------------------------------------------------------------------------------
# Jupyter / notebooks
# ------------------------------------------------------------------------------
# Ignore auto-saved notebook checkpoints everywhere
**/.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Artifacts: keep the folder structure but ignore heavy binaries
# ------------------------------------------------------------------------------

# Ignore large/binary run outputs inside artifacts
artifacts/**/*.nc
artifacts/**/*.h5
artifacts/**/*.npz
artifacts/**/*.pkl

# Re-include human-readable / lightweight files for experiment traceability
!artifacts/**/*.csv
!artifacts/**/config.yaml
!artifacts/**/config.json
!artifacts/**/metrics.jsonl
!artifacts/**/events.log
!artifacts/**/notes.md

# Keep placeholder directories (use an empty .gitkeep file)
!artifacts/**/.gitkeep

# ------------------------------------------------------------------------------
# Local data (do not track raw CSVs)
# ------------------------------------------------------------------------------

data/**/*.csv
!data/.gitkeep

__pycache__/
*.py[cod]

